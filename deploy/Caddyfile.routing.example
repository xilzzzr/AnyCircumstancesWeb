# Merge these handlers into the existing HTTPS site block after preserving any
# production-specific logging, headers, TLS, and upstream settings. The backend
# matcher reflects the route prefixes exposed by backend/server.js.
anycircumstances.com, www.anycircumstances.com {
	encode zstd gzip
	root * /var/www/anycircumstances/dist

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://checkout.stripe.com; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://*.amazonaws.com https://api.stripe.com; frame-src https://js.stripe.com https://checkout.stripe.com; upgrade-insecure-requests"
	}

	@backend path /auth /auth/* /files /files/* /stripe/webhook /apple /apple/* /health
	handle @backend {
		reverse_proxy 127.0.0.1:3002
	}

	# Hashed assets must resolve to files or 404, never the SPA shell.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# These routes are intentionally client-rendered. Limit the SPA fallback to
	# exact authentication pages and the private/dynamic namespaces in App.tsx.
	@client_spa path /login /signup /verify-email /verification /email-verified /create-pin /create-panic-pin /onboarding /forgot-password /reset-password /app /app/* /share /share/* /cookies /status
	handle @client_spa {
		header Cache-Control "no-cache"
		rewrite * /spa.html
		file_server
	}

	# Public pages resolve to their prerendered <route>/index.html files. Assets
	# and crawl files resolve normally. Anything else emits a real 404.
	handle {
		header Cache-Control "no-cache"
		try_files {path} {path}/index.html =404
		file_server
	}

	# file_server preserves the original 404 status inside handle_errors.
	handle_errors 404 {
		header Cache-Control "no-cache"
		rewrite * /404.html
		file_server
	}
}
